Package: VarSelLCM
Type: Package
Title: Variable Selection for Model-Based Clustering of Mixed-Type Data
        Set with Missing Values
Version: 2.1.3.2
Date: 2025-09-19
Authors@R: c(person(given = "Matthieu",
                      family = "Marbac",
                      role = "aut"),
               person(given = "Mohammed",
